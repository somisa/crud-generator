{
    "name": "somisa/crud-generator",
    "license": "MIT",
    "description": "Laravel CRUD Generator",
    "keywords": [
        "laravel",
        "crud",
        "crud generator",
        "laravel crud generator",
        "api generator"
    ],
    "authors": [
        {
            "name": "Sohel Amin",
            "email": "sohelamincse@gmail.com",
            "homepage": "http://www.appzcoder.com"
        }, {
            "name": "András Somos",
            "email": "info@somisa.hu",
            "homepage": "https://www.somosandras.hu"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "suggest": {
        "laravel/breeze": "The generated views use the <x-app-layout> component and Tailwind classes of a Breeze project; without it, publish the stubs and change the layout (see the README). The model and migration commands do not need it."
    },
    "require-dev": {
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^5.7|^8.0|^9.0",
        "orchestra/testbench": "^3.3|^4.0|^5.0"
    },
    "replace": {
        "appzcoder/crud-generator": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Appzcoder\\CrudGenerator\\": "src/"
        },
        "classmap": [
            "tests"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Appzcoder\\CrudGenerator\\CrudGeneratorServiceProvider"
            ]
        }
    }
}
